{
  "name": "todolist",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "backend:dev": "pnpm --dir backend dev",
    "backend:migrate": "pnpm --dir backend prisma:migrate",
    "backend:seed": "pnpm --dir backend prisma:seed",
    "seed:stress": "SEED_MODE=stress STRESS_DATASET=all pnpm --dir backend prisma:seed",
    "seed:stress:single": "SEED_MODE=stress STRESS_DATASET=single pnpm --dir backend prisma:seed",
    "seed:stress:ten": "SEED_MODE=stress STRESS_DATASET=ten pnpm --dir backend prisma:seed",
    "seed:stress:many": "SEED_MODE=stress STRESS_DATASET=many pnpm --dir backend prisma:seed",
    "backend:test": "pnpm --dir backend test:run",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx",
    "lint:fix": "eslint . --ext .js,.jsx,.ts,.tsx --fix",
    "format": "prettier --write .",
    "preview": "vite preview",
    "prepare": "husky install",
    "test:ui": "PLAYWRIGHT_BROWSERS_PATH=.playwright VITE_OPEN_BROWSER=false playwright test -c playwright.config.ts",
    "test:responsive": "PLAYWRIGHT_BROWSERS_PATH=.playwright VITE_OPEN_BROWSER=false playwright test -c playwright.config.ts tests/responsive/responsive-stress.spec.ts",
    "test:responsive:smoke": "PLAYWRIGHT_BROWSERS_PATH=.playwright VITE_OPEN_BROWSER=false playwright test -c playwright.config.ts tests/responsive/responsive-smoke.spec.ts",
    "storybook": "HOME=$PWD XDG_CONFIG_HOME=.config STORYBOOK_DISABLE_TELEMETRY=1 STORYBOOK_DISABLE_UPDATE_CHECK=1 storybook dev -p 6006",
    "build-storybook": "HOME=$PWD XDG_CONFIG_HOME=.config STORYBOOK_DISABLE_TELEMETRY=1 STORYBOOK_DISABLE_UPDATE_CHECK=1 storybook build",
    "lighthouse": "LIGHTHOUSE_API_PORT=4301 VITE_OPEN_BROWSER=false VITE_API_URL=http://127.0.0.1:4301/api pnpm build && PLAYWRIGHT_BROWSERS_PATH=.playwright LIGHTHOUSE_API_PORT=4301 node scripts/run-lighthouse.mjs",
    "test": "vitest src",
    "test:run": "vitest run src"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@hookform/resolvers": "^5.2.2",
    "@mui/icons-material": "^7.3.1",
    "@mui/material": "^7.3.1",
    "@openai/codex": "^0.66.0",
    "@reduxjs/toolkit": "^2.8.2",
    "axios": "^1.13.1",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.66.1",
    "react-redux": "^9.2.0",
    "react-router": "^7.9.6",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.1",
    "@playwright/test": "^1.58.2",
    "@storybook/addon-essentials": "8.6.14",
    "@storybook/addon-viewport": "^8.6.14",
    "@storybook/react": "8.6.14",
    "@storybook/react-vite": "^8.6.14",
    "@types/node": "^24.3.1",
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "@vitejs/plugin-react": "^4.6.0",
    "chrome-launcher": "^1.2.1",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.20",
    "globals": "^16.3.0",
    "husky": "^8.0.0",
    "lighthouse": "^13.0.3",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "storybook": "^8.6.14",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "^7.0.4",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@10.30.1+sha512.3590e550d5384caa39bd5c7c739f72270234b2f6059e13018f975c313b1eb9fefcc09714048765d4d9efe961382c312e624572c0420762bdc5d5940cdf9be73a"
}
